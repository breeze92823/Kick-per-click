# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Optional progression overrides, applied on every load (override the saved game). Leave empty/unset to disable.
# e.g. VITE_START_LEVEL=19  VITE_START_REBIRTHS=1  VITE_START_WINS=500000
VITE_START_LEVEL=
VITE_START_REBIRTHS=
VITE_START_WINS=

# Colyseus server (../Kick-per-click-backend), one URL per Bloxity Legion channel.
# `npm run dev` / `build:dev` use _DEV (npm run dev defaults to ws://localhost:2567); `npm run build` uses _MAIN.
# Leave a URL empty to let the Bloxity SDK resolve that channel's endpoint at runtime.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
